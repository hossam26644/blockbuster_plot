import os
import yaml
from distutils.util import strtobool

configfile: "box_plot_figure/config.yml"

OUT_DIR = config["output_dir"]
SEQ_LENGTHS = config["seq_lengths"]  # Assuming this is a list in your config
KS = config.get("ks", None)

if (KS is not None) and (len(KS) > 1):
    assert len(SEQ_LENGTHS) == 1, "If ks is provided, simulate one sequence length only"
elif KS is None:
    KS = [1]
else:
    assert len(KS) == 1, "If ks is provided, it should be a list of length 1 or None"

if "branch_sfs" in config and config["branch_sfs"] is not None:
    branch_val = bool(strtobool(str(config["branch_sfs"])))
    suffix = "branch" if branch_val else "mut"
    BRANCH_SFS_OPTIONS = [(branch_val, suffix)]
else:
    BRANCH_SFS_OPTIONS = [(True, "branch"), (False, "mut")]


# Read the base config for pipeline X
with open("box_plot_figure/config.yml", 'r') as f:
    base_inner_config = yaml.safe_load(f)


slots = config.get("slots", 4)
threads_per_seq = int(16/slots)
print(f"Allocating {threads_per_seq} threads per sequence length")


SUFFIX_TO_BRANCH_SFS = {suffix: value for value, suffix in BRANCH_SFS_OPTIONS}

rule all:
    input:
        [f"{OUT_DIR}_seq_{seq_length}_k{k}_{suffix}/config.yml" 
         for seq_length in SEQ_LENGTHS
         for k in KS
         for _, suffix in BRANCH_SFS_OPTIONS],      
        f"{OUT_DIR}_done.txt"
        


rule create_inner_config:
    output:
        config_file = "{output}_seq_{seq_length}_k{k}_{suffix}/config.yml"
    params:
        output_name = lambda wildcards: f"{wildcards.output}_seq_{wildcards.seq_length}_k{wildcards.k}_{wildcards.suffix}",
        seq_length = lambda wildcards: int(wildcards.seq_length),
        k = lambda wildcards: int(wildcards.k),
        branch_sfs = lambda wildcards: SUFFIX_TO_BRANCH_SFS[wildcards.suffix]
    run:
        # Copy base config and update parameters
        inner_config = base_inner_config.copy()
        inner_config["sequence_length"] = params.seq_length
        inner_config["output_dir"] = params.output_name
        inner_config["branch_sfs"] = params.branch_sfs
        inner_config["k"] = params.k
        del inner_config["seq_lengths"]  # Remove seq_lengths to avoid confusion
        del inner_config["ks"]  # Remove ks to avoid confusion
        # Create directory and write config
        os.makedirs(os.path.dirname(output.config_file), exist_ok=True)
        with open(output.config_file, 'w') as f:
            yaml.dump(inner_config, f)


rule run_single_sequence_length:
    input:
        config_file = "{output}_seq_{seq_length}_k{k}_{suffix}/config.yml"
    output:
        result = "{output}_seq_{seq_length}_k{k}_{suffix}/results.png",
        status = "{output}_seq_{seq_length}_k{k}_{suffix}/status.txt"
    params:
        workdir = "{output}_seq_{seq_length}_k{k}_{suffix}",
        snakefile = "box_plot_figure/predict_one_set/SnakefileInner",
        graph = config["graph"]
    resources:
        parallel_slots=1 
    shell:
        """
        if snakemake -s {params.snakefile} \
            --configfile {input.config_file} \
            --cores {threads_per_seq} \
            --directory {params.workdir} \
            {output.result}; then   

            echo "SUCCESS" > {output.status} 

        else
            echo "FAILED" > {output.status}
            touch {output.result}  # Create empty placeholder
        fi \
        """


rule create_boxplot:
    input:
        statuses = expand("{output}_seq_{seq_length}_k{k}_{suffix}/status.txt",
                         output=OUT_DIR,
                         k=KS,
                         seq_length=SEQ_LENGTHS,
                         suffix=[suffix for _, suffix in BRANCH_SFS_OPTIONS])
    output:
        combinedplot = "{output}_combinedplot.png",
        decay = "{output}_decay.png"
    params:
        workdir = OUT_DIR
    run:
        # Collect successful sequence lengths
        successful_lengths = []
        for status_file in input.statuses:
            with open(status_file, 'r') as f:
                if "SUCCESS" in f.read():
                    seq_len = status_file.split("_seq_")[1].split("/")[0]
                    successful_lengths.append(seq_len)
        print(f"Successful sequence lengths: {successful_lengths}")
        # Call boxplot.py with successful lengths
        import subprocess
        if successful_lengths:
            cmd = ["python", "box_plot_figure/calculate_area.py", "exportdata", "-s"] + successful_lengths + ["-o", wildcards.output, "-r", config["graph"], "-p", params.workdir]
            print(" ".join(cmd))
            subprocess.run(cmd, check=True)
            cmd = ["python", "box_plot_figure/calculate_area.py", "draw", "-s"] + successful_lengths + ["-o", wildcards.output, "-r", config["graph"], "-p", params.workdir]
            print(" ".join(cmd))
            subprocess.run(cmd, check=True)
        else:
            # Handle case with no successful runs
            with open(output.combinedplot, 'w') as f:
                f.write("No successful runs")


rule run_finalize:
    input:
        results = expand("{output}_seq_{seq_length}_k{k}_{suffix}/results.png", 
                        output=OUT_DIR, 
                        k=KS,
                        seq_length=SEQ_LENGTHS,
                        suffix=[suffix for _, suffix in BRANCH_SFS_OPTIONS]),
        statuses = expand("{output}_seq_{seq_length}_k{k}_{suffix}/status.txt",
                         output=OUT_DIR,
                         k=KS,
                         seq_length=SEQ_LENGTHS,
                         suffix=[suffix for _, suffix in BRANCH_SFS_OPTIONS]),
        combinedplot = "{output}_combinedplot.png"  # Add dependency on boxplot
    output:
        "{output}_done.txt"
    run:
        # Check which runs succeeded
        failed_runs = []
        for status_file in input.statuses:
            with open(status_file, 'r') as f:
                if "FAILED" in f.read():
                    seq_len = status_file.split("_seq_")[1].split("/")[0]
                    failed_runs.append(seq_len)
        
        with open(output[0], 'w') as f:
            f.write("Pipeline completed\n")
            if failed_runs:
                f.write(f"Failed sequence lengths: {', '.join(failed_runs)}\n")
            else:
                f.write("All runs succeeded\n")